[Unit]
Description=macOS Screen Sharing Privacy Watcher (Auto-DND + Presentation Mode)
PartOf=graphical-session.target
After=graphical-session.target pipewire.service plasma-plasmashell.service

[Service]
Type=simple
ExecStart=%h/.local/bin/macos-screenshare-privacy.py
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
