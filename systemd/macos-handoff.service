[Unit]
Description=macOS Handoff Bidirectional Universal Clipboard (Text, URLs & Images)
PartOf=graphical-session.target
After=graphical-session.target plasma-plasmashell.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/macos-handoff-daemon.py
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
