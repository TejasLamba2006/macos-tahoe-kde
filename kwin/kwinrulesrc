[General]
Order=chrome-doc-pip,pip-always-on-top,konsole-opacity,betternotes-stickies,macos-quicklook,macos-force-quit

[betternotes-stickies]
Description=BetterNotes Sticky Notes (Skip Taskbar & Hidden on Screen Share)
excludefromcapture=true
excludefromcapturerule=2
skippager=true
skippagerrule=2
skipswitcher=true
skipswitcherrule=2
skiptaskbar=true
skiptaskbarrule=2
types=512
typesrule=2
wmclass=betternotes
wmclasscomplete=false
wmclassmatch=1

[chrome-doc-pip]
Description=Chrome Document Picture-in-Picture (Google Meet / Web Apps) Always on Top
above=true
aboverule=2
skipswitcher=true
skipswitcherrule=2
skiptaskbar=true
skiptaskbarrule=2
title=^(?!.* - (Google Chrome|Chromium|Brave)$).+$
titlematch=3
types=1
wmclass=^(google-chrome|chromium|brave-browser)$
wmclassmatch=3

[konsole-opacity]
Description=Konsole slight transparency
opacityactive=92
opacityactiverule=2
opacityinactive=88
opacityinactiverule=2
wmclass=konsole|yakuake
wmclassmatch=3

[macos-force-quit]
Description=macOS Force Quit Applications Centered Floating Dialog
above=true
aboverule=2
placement=4
placementrule=2
skippager=true
skippagerrule=2
skipswitcher=true
skipswitcherrule=2
skiptaskbar=true
skiptaskbarrule=2
wmclass=python3|macos-force-quit
wmclassmatch=3
title=Force Quit Applications
titlematch=1

[macos-quicklook]
Description=macOS Quick Look Centered Preview
above=true
aboverule=2
placement=4
placementrule=2
skippager=true
skippagerrule=2
wmclass=python3|macos-quicklook
wmclassmatch=3
title=Quick Look
titlematch=1

[pip-always-on-top]
Description=macOS Picture-in-Picture & Chrome Document PiP Always on Top
above=true
aboverule=2
decorationpolicy=none
decorationpolicyrule=2
skipswitcher=true
skipswitcherrule=2
skiptaskbar=true
skiptaskbarrule=2
title=^(Picture-in-Picture|Picture in picture|Picture-in-picture)$
titlematch=3
types=1
