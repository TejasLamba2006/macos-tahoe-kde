#!/usr/bin/env bash
# ponytail: macOS Sequoia "iPhone Mirroring" + Bluetooth HFP / KDE Connect / ADB Phone Call, Audio Route & Contacts controller
set -euo pipefail

MIRROR_PID_FILE="/run/user/$(id -u)/macos-phone-mirror.pid"
AUDIO_ROUTE_FILE="$HOME/.config/macos-phone-audio-route"

find_adb_serial() {
    local ser
    ser=$(adb devices 2>/dev/null | awk 'NR>1 && $2=="device" {print $1}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+$' | head -1 || true)
    if [[ -z "$ser" ]]; then
        ser=$(adb devices 2>/dev/null | awk 'NR>1 && $2=="device" {print $1}' | head -1 || true)
    fi
    if [[ -z "$ser" ]]; then
        local target
        target=$(timeout 1.5 avahi-browse -rp _adb-tls-connect._tcp 2>/dev/null | awk -F';' '/^=.*IPv4/ {print $8":"$9; exit}' || true)
        if [[ -n "$target" ]]; then
            adb connect "$target" >/dev/null 2>&1 || true
            ser="$target"
        fi
    fi
    echo "$ser"
}

find_ag_path() {
    busctl --user call org.pipewire.Telephony /org/pipewire/Telephony org.ofono.Manager GetModems 2>/dev/null \
        | grep -oE '/org/pipewire/Telephony/ag[0-9]+' | head -1 || true
}

get_bt_card() {
    pactl list cards short 2>/dev/null | awk '/bluez_card\./ {print $2; exit}' || true
}

set_audio_route() {
    local mode="${1:-}"
    local card
    card=$(get_bt_card)
    if [[ -z "$mode" || "$mode" == "toggle" ]]; then
        local cur="phone"
        [[ -f "$AUDIO_ROUTE_FILE" ]] && cur=$(cat "$AUDIO_ROUTE_FILE" 2>/dev/null || echo "phone")
        if [[ "$cur" == "laptop" ]]; then mode="phone"; else mode="laptop"; fi
    fi
    echo "$mode" > "$AUDIO_ROUTE_FILE"

    if [[ "$mode" == "phone" ]]; then
        # Disable A2DP Audio Sink on laptop so Android never routes phone media/reels to PC, while keeping HFP call gateway ready
        cat > "$HOME/.config/wireplumber/wireplumber.conf.d/50-macos-hfp-hf.conf" << 'EOF'
monitor.bluez.properties = {
  bluez5.roles = [ a2dp_sink bap_sink bap_source hsp_hs hsp_ag hfp_hf hfp_ag ]
  bluez5.hfphsp-backend = "native"
}
EOF
        local mac
        mac=$(bluetoothctl devices Paired 2>/dev/null | awk '{print $2; exit}' || true)
        if [[ -n "$mac" ]]; then
            busctl --system call org.bluez "/org/bluez/hci0/dev_${mac//:/_}" org.bluez.Device1 DisconnectProfile s "0000110a-0000-1000-8000-00805f9b34fb" >/dev/null 2>&1 || true
        fi
        local ag
        ag=$(find_ag_path)
        if [[ -n "$ag" ]]; then
            busctl --user set-property org.pipewire.Telephony "$ag" org.pipewire.Telephony.AudioGatewayTransport1 RejectSCO b true 2>/dev/null || true
        fi
        ~/.local/bin/island-push --flash --title "Phone Audio → Phone" --subtitle "Media & calls play on your phone speaker" --icon smartphone-symbolic --color orange --duration 2500 2>/dev/null || true
    else
        # Enable A2DP Source + HFP so phone media and calls play through Laptop Mic & Speakers
        cat > "$HOME/.config/wireplumber/wireplumber.conf.d/50-macos-hfp-hf.conf" << 'EOF'
monitor.bluez.properties = {
  bluez5.roles = [ a2dp_sink a2dp_source bap_sink bap_source hsp_hs hsp_ag hfp_hf hfp_ag ]
  bluez5.hfphsp-backend = "native"
}
EOF
        systemctl --user restart wireplumber 2>/dev/null || true
        sleep 1.5
        ensure_bt_hfp >/dev/null 2>&1 || true
        local mac
        mac=$(bluetoothctl devices Paired 2>/dev/null | awk '{print $2; exit}' || true)
        if [[ -n "$mac" ]]; then
            bluetoothctl connect "$mac" >/dev/null 2>&1 || true
        fi
        card=$(get_bt_card)
        if [[ -n "$card" ]]; then
            pactl set-card-profile "$card" audio-gateway 2>/dev/null || true
        fi
        local ag
        ag=$(find_ag_path)
        if [[ -n "$ag" ]]; then
            busctl --user set-property org.pipewire.Telephony "$ag" org.pipewire.Telephony.AudioGatewayTransport1 RejectSCO b false 2>/dev/null || true
        fi
        ~/.local/bin/island-push --flash --title "Phone Audio → Laptop" --subtitle "Media & calls routed to Mac Mic + Speakers" --icon audio-headphones-symbolic --color green --duration 2500 2>/dev/null || true
    fi
}

ensure_bt_hfp() {
    local ag
    ag=$(find_ag_path)
    if [[ -n "$ag" ]]; then
        echo "$ag"
        return 0
    fi
    rfkill unblock bluetooth 2>/dev/null || true
    bluetoothctl power on >/dev/null 2>&1 || true
    local mac
    mac=$(bluetoothctl devices Paired 2>/dev/null | awk '{print $2; exit}' || true)
    if [[ -n "$mac" ]]; then
        bluetoothctl connect "$mac" 0000111f-0000-1000-8000-00805f9b34fb >/dev/null 2>&1 || bluetoothctl connect "$mac" >/dev/null 2>&1 || true
        sleep 1
    fi
    find_ag_path
}

sync_contacts() {
    # 1. Trigger KDE Connect contacts synchronizeRemoteWithLocal
    local dev
    dev=$(qdbus6 org.kde.kdeconnect /modules/kdeconnect org.kde.kdeconnect.daemon.devices 2>/dev/null | head -1 || true)
    if [[ -n "$dev" ]]; then
        qdbus6 org.kde.kdeconnect "/modules/kdeconnect/devices/$dev/contacts" org.kde.kdeconnect.device.contacts.synchronizeRemoteWithLocal >/dev/null 2>&1 || true
    fi
    ~/.local/bin/island-push --flash --title "Contacts Synced" --subtitle "Phone address book updated in Dynamic Island" --icon view-pim-contacts --color blue --duration 2500 2>/dev/null || true
}

is_mirror_running() {
    [[ -f "$MIRROR_PID_FILE" ]] && kill -0 "$(cat "$MIRROR_PID_FILE")" 2>/dev/null
}

start_mirror() {
    if is_mirror_running; then
        stop_mirror
        exit 0
    fi
    local ser
    ser=$(find_adb_serial)
    if [[ -z "$ser" ]]; then
        if ! ~/.local/bin/macos-adb-pair.py; then
            exit 1
        fi
        ser=$(find_adb_serial)
    fi
    local route="laptop"
    [[ -f "$AUDIO_ROUTE_FILE" ]] && route=$(cat "$AUDIO_ROUTE_FILE" 2>/dev/null || echo "laptop")
    local audio_flag="--no-audio"
    [[ "$route" == "laptop" ]] && audio_flag=""
    nohup scrcpy -s "$ser" \
        --window-title="iPhone Mirroring" \
        --always-on-top \
        --window-width=380 \
        --window-height=820 \
        --stay-awake \
        --turn-screen-off \
        $audio_flag \
        >/dev/null 2>&1 &
    echo $! > "$MIRROR_PID_FILE"
    ~/.local/bin/island-push --flash --title "Phone Mirroring Active" --subtitle "Full touch, keyboard & audio mirrored" --icon smartphone-symbolic --color green --duration 3000 2>/dev/null || true
}

stop_mirror() {
    if is_mirror_running; then
        kill "$(cat "$MIRROR_PID_FILE")" 2>/dev/null || true
        rm -f "$MIRROR_PID_FILE"
    fi
    pkill -f 'scrcpy.*--window-title=iPhone Mirroring' 2>/dev/null || true
}

dial_number() {
    local num="${1:-}"
    num=$(echo "$num" | tr -cd '0-9+*#')
    if [[ -z "$num" ]]; then
        exit 1
    fi
    local route="laptop"
    [[ -f "$AUDIO_ROUTE_FILE" ]] && route=$(cat "$AUDIO_ROUTE_FILE" 2>/dev/null || echo "laptop")
    local ag
    ag=$(ensure_bt_hfp)
    if [[ -n "$ag" ]]; then
        busctl --user call org.pipewire.Telephony "$ag" org.ofono.VoiceCallManager Dial s "$num" >/dev/null 2>&1 && {
            if [[ "$route" == "laptop" ]]; then
                local card
                card=$(get_bt_card)
                [[ -n "$card" ]] && pactl set-card-profile "$card" audio-gateway 2>/dev/null || true
                busctl --user set-property org.pipewire.Telephony "$ag" org.pipewire.Telephony.AudioGatewayTransport1 RejectSCO b false 2>/dev/null || true
                busctl --user call org.pipewire.Telephony "$ag" org.pipewire.Telephony.AudioGatewayTransport1 Activate >/dev/null 2>&1 || true
                ~/.local/bin/island-push --id phone-call --category call --title "Calling $num" --subtitle "Audio on Laptop Mic & Speakers" --icon call-start-symbolic --color green --priority 95 2>/dev/null || true
            else
                busctl --user set-property org.pipewire.Telephony "$ag" org.pipewire.Telephony.AudioGatewayTransport1 RejectSCO b true 2>/dev/null || true
                ~/.local/bin/island-push --id phone-call --category call --title "Calling $num" --subtitle "Audio on Phone Earpiece" --icon call-start-symbolic --color orange --priority 95 2>/dev/null || true
            fi
            exit 0
        }
    fi
    local ser
    ser=$(find_adb_serial)
    if [[ -n "$ser" ]]; then
        adb -s "$ser" shell am start -a android.intent.action.CALL -d "tel:$num" >/dev/null 2>&1 || true
        ~/.local/bin/island-push --id phone-call --category call --title "Calling $num" --subtitle "Dialing via Phone" --icon call-start-symbolic --color green --priority 95 2>/dev/null || true
    fi
}

answer_call() {
    local ag
    ag=$(ensure_bt_hfp)
    if [[ -n "$ag" ]]; then
        local call_path
        call_path=$(busctl --user call org.pipewire.Telephony "$ag" org.ofono.VoiceCallManager GetCalls 2>/dev/null | grep -oE '/org/pipewire/Telephony/ag[0-9]+/call[0-9]+' | head -1 || true)
        if [[ -n "$call_path" ]]; then
            busctl --user call org.pipewire.Telephony "$call_path" org.ofono.VoiceCall Answer >/dev/null 2>&1 || true
        else
            busctl --user call org.pipewire.Telephony "$ag" org.ofono.VoiceCallManager HoldAndAnswer >/dev/null 2>&1 || true
        fi
        local route="laptop"
        [[ -f "$AUDIO_ROUTE_FILE" ]] && route=$(cat "$AUDIO_ROUTE_FILE" 2>/dev/null || echo "laptop")
        if [[ "$route" == "laptop" ]]; then
            busctl --user call org.pipewire.Telephony "$ag" org.pipewire.Telephony.AudioGatewayTransport1 Activate >/dev/null 2>&1 || true
        fi
    fi
    local ser
    ser=$(find_adb_serial)
    if [[ -n "$ser" ]]; then
        adb -s "$ser" shell input keyevent 5 >/dev/null 2>&1 || true
    fi
}

hangup_call() {
    local ag
    ag=$(find_ag_path)
    if [[ -n "$ag" ]]; then
        busctl --user call org.pipewire.Telephony "$ag" org.ofono.VoiceCallManager HangupAll >/dev/null 2>&1 || true
    fi
    local ser
    ser=$(find_adb_serial)
    if [[ -n "$ser" ]]; then
        adb -s "$ser" shell input keyevent 6 >/dev/null 2>&1 || true
    fi
    ~/.local/bin/island-push --id phone-call --done --status cancel 2>/dev/null || true
}

case "${1:-}" in
    mirror) start_mirror ;;
    stop-mirror) stop_mirror ;;
    dial) dial_number "${2:-}" ;;
    answer) answer_call ;;
    hangup) hangup_call ;;
    audio-route) set_audio_route "${2:-toggle}" ;;
    sync-contacts) sync_contacts ;;
    connect-audio) ensure_bt_hfp ;;
esac
