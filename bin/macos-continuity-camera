#!/usr/bin/env bash
# ponytail: macOS Continuity Camera controller — auto-discovers/pairs Wireless ADB and streams phone camera to /dev/video9
set -euo pipefail

PID_FILE="/run/user/$(id -u)/continuity-camera.pid"
FACING="${2:-back}"
V4L2_DEV="/dev/video9"

if [ ! -e "$V4L2_DEV" ]; then
    sudo -n modprobe v4l2loopback devices=1 video_nr=9 card_label="Continuity Camera" exclusive_caps=1 2>/dev/null || true
fi

is_running() {
    [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

stop_cam() {
    if is_running; then
        kill "$(cat "$PID_FILE")" 2>/dev/null || true
        rm -f "$PID_FILE"
    fi
    pkill -f "scrcpy.*--v4l2-sink=$V4L2_DEV" 2>/dev/null || true
    ~/.local/bin/island-push --id continuity-cam --done --status cancel 2>/dev/null || true
    echo "stopped"
}

ensure_adb() {
    if adb get-state >/dev/null 2>&1; then
        return 0
    fi
    # Check mDNS for already-paired _adb-tls-connect._tcp
    local conn
    conn=$(adb mdns services 2>/dev/null | awk '/_adb-tls-connect\._tcp/{print $NF}' | head -1 || true)
    if [ -n "$conn" ]; then
        adb connect "$conn" >/dev/null 2>&1 || true
        if adb get-state >/dev/null 2>&1; then
            return 0
        fi
    fi

    # Prompt user for one-time Wireless Debugging Pairing (IP:Port + 6-digit code) or IP:Port connect
    local ans
    ans=$(kdialog --title "macOS Continuity Camera — Wireless ADB Setup" \
        --inputbox "On your Android phone:\n1. Open Settings → Developer options → Wireless debugging\n2. Tap 'Pair device with pairing code'\n3. Enter the IP:Port and 6-digit code below (separated by a space), OR just IP:Port if already paired:\n\nExample: 192.168.1.33:39123 482910" "" 2>/dev/null || true)
    if [ -z "$ans" ]; then
        return 1
    fi
    local addr code
    read -r addr code <<< "$ans"
    if [ -n "${code:-}" ]; then
        adb pair "$addr" "$code" >/dev/null 2>&1 || true
        sleep 1
        local new_conn
        new_conn=$(adb mdns services 2>/dev/null | awk '/_adb-tls-connect\._tcp/{print $NF}' | head -1 || true)
        if [ -n "$new_conn" ]; then
            adb connect "$new_conn" >/dev/null 2>&1 || true
        else
            local ip_only="${addr%%:*}"
            local port_ans
            port_ans=$(kdialog --title "macOS Continuity Camera" --inputbox "Paired! Now enter the main 'IP address & Port' shown on the Wireless debugging screen:" "${ip_only}:" 2>/dev/null || true)
            [ -n "$port_ans" ] && adb connect "$port_ans" >/dev/null 2>&1 || true
        fi
    else
        adb connect "$addr" >/dev/null 2>&1 || true
    fi
    adb get-state >/dev/null 2>&1
}

start_cam() {
    if is_running; then
        stop_cam
    fi
    if ! ensure_adb; then
        ~/.local/bin/island-push --flash --title "Continuity Camera" --subtitle "Wireless ADB not paired yet" --icon camera-web-symbolic --color orange --duration 3500 2>/dev/null || true
        echo "no-device"
        exit 1
    fi
    nohup scrcpy --video-source=camera --camera-facing="$FACING" --camera-size=1920x1080 --v4l2-sink="$V4L2_DEV" --no-playback --no-audio >/dev/null 2>&1 &
    echo $! > "$PID_FILE"
    ~/.local/bin/island-push --id continuity-cam --category recording --title "Continuity Camera" --subtitle "Streaming ($FACING) → /dev/video9" --icon camera-video-symbolic --color green --priority 90 2>/dev/null || true
    echo "started:$FACING"
}

case "${1:-status}" in
    start) start_cam ;;
    stop) stop_cam ;;
    toggle)
        if is_running; then stop_cam; else start_cam; fi
        ;;
    flip)
        stop_cam
        sleep 0.3
        FACING="front" start_cam
        ;;
    status)
        if is_running; then echo "running"; else echo "stopped"; fi
        ;;
esac
